# Nuschl's sandbox launcher /usr/lib/nuschl/bwrap and the bubblewrap it runs
# may create user namespaces, which Ubuntu 23.10 and later restrict. The
# workers bubblewrap starts inherit the profile; its --disable-userns leaves
# them none to create. The profile leaves them otherwise unconfined.
abi <abi/4.0>,

profile nuschl-bwrap /usr/lib/nuschl/bwrap flags=(unconfined) {
  userns,
}
