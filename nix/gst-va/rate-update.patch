+/* Recompute the bitrates and the HRD buffer from the bitrate property for
+ * the running encoder. The level and tier stay as configured. */
+static void
+_av1_update_bitrate (GstVaAV1Enc * self)
+{
+  guint bitrate, cpb_size;
+
+  GST_OBJECT_LOCK (self);
+  bitrate = self->prop.bitrate;
+  cpb_size = self->prop.cpb_size;
+  GST_OBJECT_UNLOCK (self);
+
+  self->rc.target_bitrate = bitrate;
+  if (self->rc.rc_ctrl_mode == VA_RC_CBR)
+    self->rc.max_bitrate = bitrate;
+  else
+    self->rc.max_bitrate = (guint) gst_util_uint64_scale_int (bitrate, 100,
+        self->rc.target_percentage);
+  self->rc.cpb_size = cpb_size;
+  _av1_calculate_bitrate_hrd (self);
+
+  GST_INFO_OBJECT (self, "Update target bitrate to %u kbps", bitrate);
+}
+
